# =============================================================================
# PerfPilot UI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values as needed.
# .env.local is gitignored. No real credentials belong in this file.
#
# For Docker deployment, these values are set via the docker-compose
# environment section — no .env.local file is needed inside the container.
#
# For local development, the defaults below match the standard local setup
# (backend on localhost). No .env.local file is needed unless you change ports.
# =============================================================================

# AG-UI backend URL (server-side rewrites + CopilotKit route)
# Docker override: http://agent-agui:8002
AGUI_BACKEND_URL=http://localhost:8002

# A2A server URL (server-side rewrites for agent catalog)
# Docker override: http://agent-a2a:8001
A2A_BACKEND_URL=http://localhost:8001

# Frontend listening port
# Used by Next.js dev server (npm run dev -- -p $FRONTEND_PORT)
FRONTEND_PORT=3000
