# perfpilot-mcp-confluence — standalone spin-up
# Copy this file to `.env` and fill in the Confluence credentials.
# Use the V2 block for Confluence Cloud, the V1 block for on-prem.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-confluence
HTTP_PORT=8115

# Confluence Cloud (v2 API)
CONFLUENCE_V2_BASE_URL=
CONFLUENCE_V2_USER=
CONFLUENCE_V2_API_TOKEN=

# Confluence on-prem (v1 API)
CONFLUENCE_V1_BASE_URL=
CONFLUENCE_V1_USER=
CONFLUENCE_V1_PAT=
