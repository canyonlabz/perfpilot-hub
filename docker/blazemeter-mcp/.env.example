# perfpilot-mcp-blazemeter — standalone spin-up
# Copy this file to `.env` and fill in the BlazeMeter credentials.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-blazemeter
HTTP_PORT=8110

BLAZEMETER_API_KEY=
BLAZEMETER_API_SECRET=
BLAZEMETER_ACCOUNT_ID=
BLAZEMETER_WORKSPACE_ID=
