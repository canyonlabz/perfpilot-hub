# perfpilot-mcp-jmeter — standalone spin-up
# Copy this file to `.env` and fill in only what applies.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-jmeter
HTTP_PORT=8112

# Optional: JKS client keystore for TLS client authentication.
# Both must be set together. Place the .jks file in docker/certs/jmeter/
# before building.
# JMETER_JKS_FILE=your-keystore.jks
# JMETER_JKS_PWD=your_keystore_password

# Optional: enable CookieManager.save.cookies=true in jmeter.properties
# JMETER_COOKIE_SAVE=false
