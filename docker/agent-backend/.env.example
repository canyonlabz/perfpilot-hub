# perfpilot-a2a + perfpilot-agui — standalone spin-up
# Copy this file to `.env` and fill in the LLM and Postgres values.
# Both services (A2A on 8101, AG-UI on 8102) read the same file.

DEPLOYMENT_MODE=local

# --- Listen ports (compose overrides these per service) ---
A2A_PORT=8101
AGUI_PORT=8102

# --- LLM provider (openai | azure_openai | ollama) ---
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama (inside Docker use host.docker.internal instead of localhost)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# --- MCP endpoints (gateway mode is the default) ---
# In the full-stack compose these resolve via docker DNS. Standalone
# runs use host.docker.internal to reach each container's mapped port.
GATEWAY_MCP_URL=http://host.docker.internal:8125/perfpilot-mcp-gateway/mcp
PLAYWRIGHT_MCP_URL=http://host.docker.internal:8117/mcp

# --- Optional split mode: bypass the gateway per-MCP ---
# When any of these are set the agent talks to that MCP directly instead
# of via GATEWAY_MCP_URL. Useful for debugging or Aspire deployments.
# MCP_URL_JMETER=http://host.docker.internal:8112/perfpilot-mcp-jmeter/mcp
# MCP_URL_BLAZEMETER=http://host.docker.internal:8110/perfpilot-mcp-blazemeter/mcp
# MCP_URL_DATADOG=http://host.docker.internal:8111/perfpilot-mcp-datadog/mcp
# MCP_URL_PERFANALYSIS=http://host.docker.internal:8113/perfpilot-mcp-perfanalysis/mcp
# MCP_URL_PERFREPORT=http://host.docker.internal:8114/perfpilot-mcp-perfreport/mcp
# MCP_URL_CONFLUENCE=http://host.docker.internal:8115/perfpilot-mcp-confluence/mcp
# MCP_URL_PERFMEMORY=http://host.docker.internal:8116/perfpilot-mcp-perfmemory/mcp
# MCP_URL_GITHUB=http://host.docker.internal:8118/perfpilot-mcp-github/mcp

# --- perfagent_state database (PostgreSQL) ---
# Standalone default is host.docker.internal. In the full-stack compose
# the value is `perfmem-pgvector-age` (shared with perfmemory).
PERFAGENT_STATE_HOST=host.docker.internal
PERFAGENT_STATE_PORT=5432
PERFAGENT_STATE_DB=perfagent_state
PERFAGENT_STATE_USER=perfadmin
PERFAGENT_STATE_PASSWORD=
PERFAGENT_STATE_SSLMODE=prefer
# PERFAGENT_STATE_SSLROOTCERT=

# --- Optional TLS / corporate CA bundle ---
# Set both when running behind a TLS-inspecting proxy.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Optional feature flags ---
# AUTH_ENABLED=false
# OTEL_ENABLED=false
# OTEL_EXPORTER_ENDPOINT=
# OTEL_SERVICE_NAME=perfpilot-agents
