# =============================================================================
# perfpilot-mcp-playwright — local env template
#
# Copy to `.env` only if you need optional corporate CA trust or mTLS
# client-cert support. A vanilla HTTPS-only scraping workload needs
# none of the values below — the image runs headless Chromium out of
# the box.
# =============================================================================

# Port the container listens on inside its network (host-side is fixed
# by the compose `ports:` mapping to 8117).
HTTP_PORT=8117

# ── Corporate CA trust (opt-in) ──────────────────────────────────────
# Set to `true` and drop one or more PEM files into
# docker/certs/corporate/ to bake corporate CA(s) into both the OS
# trust store and Chromium's NSS databases. Then rebuild the image:
#   docker compose up --build -d
# ENABLE_CORP_CA=true

# ── Optional mTLS client certificate ─────────────────────────────────
# The image bakes any .p12 / .pfx / .pem files from
# docker/certs/playwright/ into /certs. Setting the two variables
# below tells entrypoint.sh to import the cert into Chromium's NSS
# databases at container start.
#
# PLAYWRIGHT_CERT_FILE accepts either a bare filename (looked up under
# /certs) or an absolute path inside the container.
# PLAYWRIGHT_CERT_PASSPHRASE is required to unwrap PKCS#12 archives.
# PLAYWRIGHT_CERT_FILE=my-client-cert.pfx
# PLAYWRIGHT_CERT_PASSPHRASE=your_p12_passphrase

# ── Chromium AutoSelectCertificateForUrls policy (opt-in) ────────────
# Only written when PLAYWRIGHT_CERT_AUTO_SELECT_CN is set. Prevents
# Chromium from showing a cert picker when the target site presents a
# mutual-TLS challenge. Pattern defaults to `*` (any URL).
# PLAYWRIGHT_CERT_AUTO_SELECT_CN=my-cert-subject-cn
# PLAYWRIGHT_CERT_AUTO_SELECT_PATTERN=https://portal.example.com
