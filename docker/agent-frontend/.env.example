# perfpilot-ui — standalone spin-up
# Copy this file to `.env` only if you need to override the defaults.
# The compose file already sets PORT=8080 and points the backend URLs
# at host.docker.internal.

DEPLOYMENT_MODE=local

# --- Listen port ---
PORT=8080
FRONTEND_PORT=8080

# --- Backend URLs ---
# In the full-stack compose these resolve via docker DNS to
# perfpilot-a2a:8101 and perfpilot-agui:8102.
AGUI_BACKEND_URL=http://host.docker.internal:8102
A2A_BACKEND_URL=http://host.docker.internal:8101
