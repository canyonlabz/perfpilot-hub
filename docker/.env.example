# =============================================================================
# PerfPilot Hub — Full-stack environment (docker/.env)
#
# Copy this file to docker/.env and fill in the values you need:
#   cp .env.example .env            (Linux / macOS)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# Consumed by:
#   • docker/docker-compose-full-mac.yaml
#   • docker/docker-compose-full-windows.yaml
# via `env_file: .env` on every service.
#
# Per-component `docker/<name>/.env.example` files continue to exist for
# standalone single-container runs. This root file supersedes them when
# bringing up the full stack.
#
# Only real secrets, endpoints, and per-environment config live here.
# Service ports, MCP HTTP prefixes, and internal DNS URLs are compose-
# managed (set via `environment:` blocks in the compose file).
# =============================================================================

# --- Deployment mode ---
# local  = human-readable console logs + this .env file for secrets
# cloud  = OTel-shaped JSON logs to stdout + secrets from Vault / Key Vault
DEPLOYMENT_MODE=local

# --- Corporate CA (HTTPS-intercepting proxy / Zscaler / Norton 360 / ...) ---
# When true, docker/certs/corporate/*.pem is installed into every image.
# Rebuild is required after toggling this value.
# ENABLE_CORP_CA=false


# =============================================================================
# perfmem-pgvector-age  (PostgreSQL 18 + pgvector + AGE, port 5432)
# Shared by perfpilot-mcp-perfmemory (embeddings/graph) and by the agent
# backend (`perfagent_state` database on the same instance).
# =============================================================================
# Connection host — compose DNS name in the full-stack, or the hostname
# of an external Postgres instance if you're not running the DB in compose.
POSTGRES_HOST=perfmem-pgvector-age
POSTGRES_PORT=5432
POSTGRES_DB=perfmemory
POSTGRES_USER=perfadmin
POSTGRES_PASSWORD=your_secure_password_here

# SSL mode — local: prefer/disable; Azure/AWS/GCP: require/verify-ca/verify-full
POSTGRES_SSLMODE=prefer
# POSTGRES_SSLROOTCERT=


# =============================================================================
# perfpilot-mcp-blazemeter  (port 8110)
# https://a.blazemeter.com/app/#/account/profile
# =============================================================================
BLAZEMETER_API_KEY=your_blazemeter_api_key
BLAZEMETER_API_SECRET=your_blazemeter_api_secret
BLAZEMETER_ACCOUNT_ID=your_blazemeter_account_id
BLAZEMETER_WORKSPACE_ID=your_blazemeter_workspace_id


# =============================================================================
# perfpilot-mcp-datadog  (port 8111)
# https://app.datadoghq.com/organization-settings/api-keys
# =============================================================================
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
# Change for EU (https://api.datadoghq.eu) or other regions
DD_API_BASE_URL=https://api.datadoghq.com


# =============================================================================
# perfpilot-mcp-confluence  (port 8115)
# =============================================================================
# --- Cloud (v2 API) ---
CONFLUENCE_V2_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_V2_USER=your.email@company.com
CONFLUENCE_V2_API_TOKEN=your_cloud_api_token

# --- On-premises (v1 API) ---
CONFLUENCE_V1_BASE_URL=https://your-onprem-host
CONFLUENCE_V1_PAT=your_personal_access_token
CONFLUENCE_V1_USER=your.username


# =============================================================================
# perfpilot-mcp-perfmemory  (port 8116, connects to perfmem-pgvector-age)
# =============================================================================
# Embedding provider: openai | azure_openai | ollama
EMBEDDING_PROVIDER=openai

# --- OpenAI (embeddings) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (embeddings) ---
# Note: AZURE_OPENAI_DEPLOYMENT is shared with the agent chat model below.
# If you need distinct chat/embedding deployments in Azure, override the
# value per-service in the compose file's `environment:` block.
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Ollama (embeddings) — in Docker, use host.docker.internal for host Ollama ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# =============================================================================
# perfpilot-mcp-jmeter  (port 8112) — TLS client certificates (all optional)
# =============================================================================
# Both must be set together. Place the .jks file in docker/certs/jmeter/
# before building.
# JMETER_JKS_FILE=your-keystore.jks
# JMETER_JKS_PWD=your_keystore_password

# Enable CookieManager.save.cookies=true in jmeter.properties
# JMETER_COOKIE_SAVE=false


# =============================================================================
# perfpilot-mcp-playwright  (port 8117) — test-user client cert (optional)
# =============================================================================
# The image bakes .p12 / .pem files from docker/certs/playwright/.
# PLAYWRIGHT_CERT_PASSPHRASE=your_p12_passphrase
# PLAYWRIGHT_CERT_AUTO_SELECT_CN=TestUser1


# =============================================================================
# perfpilot-mcp-github  (port 8118)
# https://github.com/settings/tokens
# =============================================================================
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat


# =============================================================================
# perfpilot-a2a  (port 8101)  +  perfpilot-agui  (port 8102)
# =============================================================================
# LLM provider for the agent chat model: openai | azure_openai | ollama
LLM_PROVIDER=openai

# --- OpenAI (chat) — reuses OPENAI_API_KEY from the perfmemory block above ---
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (chat) — reuses AZURE_OPENAI_* from the perfmemory block ---
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Ollama (chat) ---
# OLLAMA_MODEL=llama3.1

# --- perfagent_state database (same instance as perfmemory) ---
PERFAGENT_STATE_HOST=perfmem-pgvector-age
PERFAGENT_STATE_PORT=5432
PERFAGENT_STATE_DB=perfagent_state
PERFAGENT_STATE_USER=${POSTGRES_USER}
PERFAGENT_STATE_PASSWORD=${POSTGRES_PASSWORD}
PERFAGENT_STATE_SSLMODE=prefer
# PERFAGENT_STATE_SSLROOTCERT=

# --- Corporate CA bundle for outbound HTTPS from agents (OpenAI / Azure) ---
# Set both when running behind a TLS-inspecting proxy.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Optional feature flags ---
# AUTH_ENABLED=false
# OTEL_ENABLED=false
# OTEL_EXPORTER_ENDPOINT=
# OTEL_SERVICE_NAME=perfpilot-agents


# =============================================================================
# perfpilot-mcp-gateway  (port 8125) — aggregates the 8 gateway-mounted MCPs
# =============================================================================
# In-cluster URLs are baked into the gateway image's config.yaml, so the
# eight MCP_URL_* below are only needed for split/dev mode overrides
# (bypasses the config.yaml value for a given MCP).
# MCP_URL_JMETER=http://perfpilot-mcp-jmeter:8112/perfpilot-mcp-jmeter/mcp
# MCP_URL_BLAZEMETER=http://perfpilot-mcp-blazemeter:8110/perfpilot-mcp-blazemeter/mcp
# MCP_URL_DATADOG=http://perfpilot-mcp-datadog:8111/perfpilot-mcp-datadog/mcp
# MCP_URL_PERFANALYSIS=http://perfpilot-mcp-perfanalysis:8113/perfpilot-mcp-perfanalysis/mcp
# MCP_URL_PERFREPORT=http://perfpilot-mcp-perfreport:8114/perfpilot-mcp-perfreport/mcp
# MCP_URL_CONFLUENCE=http://perfpilot-mcp-confluence:8115/perfpilot-mcp-confluence/mcp
# MCP_URL_PERFMEMORY=http://perfpilot-mcp-perfmemory:8116/perfpilot-mcp-perfmemory/mcp
# MCP_URL_GITHUB=http://perfpilot-mcp-github:8118/perfpilot-mcp-github/mcp


# =============================================================================
# Agent backend → gateway / Playwright endpoints (compose DNS names)
# =============================================================================
GATEWAY_MCP_URL=http://perfpilot-mcp-gateway:8125/perfpilot-mcp-gateway/mcp
PLAYWRIGHT_MCP_URL=http://perfpilot-mcp-playwright:8117/mcp


# =============================================================================
# perfpilot-ui  (port 8080) — Next.js frontend
# =============================================================================
AGUI_BACKEND_URL=http://perfpilot-agui:8102
A2A_BACKEND_URL=http://perfpilot-a2a:8101
