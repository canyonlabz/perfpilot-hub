# perfpilot-mcp-github — standalone spin-up
# Copy this file to `.env` and set your GitHub Personal Access Token.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-github
HTTP_PORT=8118

# PAT with `repo` scope. `GITHUB_TOKEN` is accepted as a fallback name.
GITHUB_PERSONAL_ACCESS_TOKEN=
