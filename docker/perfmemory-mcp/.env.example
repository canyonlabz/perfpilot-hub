# perfpilot-mcp-perfmemory — standalone spin-up
# Copy this file to `.env` and fill in the embedding + Postgres values.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-perfmemory
HTTP_PORT=8116

# --- Embedding provider (openai | azure_openai | ollama) ---
EMBEDDING_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (only if EMBEDDING_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama (only if EMBEDDING_PROVIDER=ollama)
# Inside Docker use host.docker.internal instead of localhost.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- PostgreSQL (pgvector + AGE) ---
# The MCP runs as a container. "localhost" inside a container resolves to
# the container itself — NOT your host machine and NOT the DB container —
# so POSTGRES_HOST=localhost will fail with "Connection refused".
#
# Correct values for common setups:
#
#   - Standalone compose (this folder + docker/postgresql/):
#       POSTGRES_HOST=host.docker.internal
#     Docker Desktop's magic hostname that resolves to the host. Requires
#     the DB's port 5432 to be bound to the host, which the standalone
#     docker/postgresql/docker-compose.yml does by default.
#
#   - Full-stack compose (docker/docker-compose-full-{windows,mac}.yaml):
#       POSTGRES_HOST=perfmem-pgvector-age
#     The DB container's name, resolvable via the shared compose network.
#     The full-stack compose reads docker/.env — not this file — and
#     docker/.env already has this value.
#
#   - External Postgres (managed cloud DB with pgvector + AGE):
#       POSTGRES_HOST=<hostname of the external instance>
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=perfmemory
POSTGRES_USER=perfadmin
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
# POSTGRES_SSLROOTCERT=
