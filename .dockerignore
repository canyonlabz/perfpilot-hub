# =============================================================================
# .dockerignore — PerfPilot Hub Gateway Docker Build Context Exclusions
# =============================================================================
# The build context is the repo root (context: ..). This file excludes
# directories and files that are not needed inside the Docker image to keep
# the build fast and the image small.
# =============================================================================

# Virtual environments (each MCP has its own .venv for local dev)
**/.venv/

# Test artifacts and results
mcp-perf-suite/artifacts/

# Git metadata
.git/
.gitignore
.gitattributes

# IDE and editor settings
.vscode/
.idea/
.cursor/

# Playwright browser automation output
.playwright-mcp/

# Documentation (not needed in image)
docs/

# Streamlit UI (separate application, not part of gateway)
mcp-perf-suite/streamlit-ui/

# Utility scripts (local dev only)
scripts/

# MS Teams and SharePoint MCPs (not Docker-eligible — require Graph API auth flow)
mcp-perf-suite/msteams-mcp/
mcp-perf-suite/sharepoint-mcp/

# Node modules (recursive — critical for agent-framework/frontend/ui/
# where a local `npm ci` for dev leaves an 800+ MB node_modules tree
# that would otherwise be shipped into the image on top of the fresh
# npm ci performed inside the Dockerfile, doubling image size).
node_modules/
.node_modules/
**/node_modules/

# Next.js build cache (recursive — same rationale as node_modules; a
# local `npm run dev` produces a 600+ MB .next/ tree at
# agent-framework/frontend/ui/.next/).
**/.next/
**/.next-*/

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/dist/
**/build/

# Test directories
**/test/
**/tests/
**/.pytest_cache/

# Docker data volumes and local compose state
docker/data/
docker/.env.gateway

# OS-specific files
.DS_Store
Thumbs.db
*.swp
*.swo

# Miscellaneous local-only files
*.log
**/.env
**/.env.*
.envrc
